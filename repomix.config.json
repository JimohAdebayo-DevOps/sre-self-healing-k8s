{
  "output": {
    "filePath": "full-idp-repo.xml",
    "style": "xml",
    "compress": true
  },
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/migrations/**",
      "**/venv/**",
      "**/node_modules/**",
      "**/*.pyc",
      "db.sqlite3",
      ".git/**"
    ]
  },
  "include": [
    "**/*.py",
    "**/*.yaml",
    "**/*.yml",
    "**/*.sh",
    "Dockerfile*",
    "Chart.yaml"
  ]
}
