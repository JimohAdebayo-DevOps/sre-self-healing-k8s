<file path="k8s/ingress-nginx/values.yaml">
controller:
  service:
    type: LoadBalancer
  
  # INDUSTRY-STANDARD SRE FIX: Disable the validating webhook during a CNI migration 
  # to completely eliminate the API Server deadlock causing the liveness probe crash.
  admissionWebhooks:
    enabled: false

  # Explicitly bypass the broken eBPF ClusterIP
  extraEnvs:
    - name: KUBERNETES_SERVICE_HOST
      value: "192.168.0.150"
    - name: KUBERNETES_SERVICE_PORT
      value: "6443"
</file>

<file path="k8s/n8n/n8n-backup-job.yaml">
apiVersion: batch/v1
kind: CronJob
metadata:
  name: n8n-nightly-backup
  namespace: n8n
spec:
  schedule: "0 3 * * *"
  jobTemplate:
    spec:
      template:
        spec:
          # This is to ensure the backup job runs on worker-01 where the RAID is
          # AND where n8n should be to access the RWO volume
          nodeSelector:
            kubernetes.io/hostname: k8s-worker-01 
          containers:
          - name: backup-worker
            image: postgres:15-alpine
            env:
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: postgres-password
            command:
            - /bin/sh
            - -c
            - |
              # CRITICAL SRE FIX: Enforce pipeline failure if pg_dump fails
              set -o pipefail
              
              DATE=$(date +%Y-%m-%d_%H-%M)
              DB_FILE="/backup/n8n_db_$DATE.sql.gz"
              FS_FILE="/backup/n8n_files_$DATE.tar.gz"

              echo "--- Starting Full Production Backup ---"

              # 1. Database Backup
              echo "Dumping Database..."
              pg_dump -h postgresql-db.n8n.svc.cluster.local -U postgres n8n | gzip > $DB_FILE

              # 2. Keycloak Identity Backup (To prevent Identity Loss)
              echo "Dumping Keycloak Database..."
              pg_dump -h postgresql-db.n8n.svc.cluster.local -U postgres keycloak | gzip > "/backup/keycloak_db_$DATE.sql.gz"

              # 2. Binary & Config Backup
              echo "Archiving n8n Files (Binaries/Configs)..."
              # 'c'reate 'z'ip 'f'ile
              tar -czf $FS_FILE -C /n8n-data .

              if [ $? -eq 0 ]; then
                echo "SUCCESS: Database and Files backed up."
                echo "Cleaning up archives older than 7 days..."
                find /backup -type f -name "*.gz" -mtime +7 -delete
              else
                echo "FAILURE: Backup encountered an error."
                exit 1
              fi
            volumeMounts:
            - name: raid5-storage
              mountPath: /backup
            - name: n8n-longhorn-data
              mountPath: /n8n-data
              readOnly: true # This is for Safety so Backup should not change original files
          restartPolicy: OnFailure
          volumes:
          - name: raid5-storage
            persistentVolumeClaim:
              claimName: n8n-db-backup-pvc
          - name: n8n-longhorn-data
            persistentVolumeClaim:
              claimName: n8n-data
</file>

<file path="k8s/n8n/n8n-deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
  namespace: n8n
spec:
  replicas: 1
  selector:
    matchLabels:
      app: n8n
  template:
    metadata:
      labels:
        app: n8n
    spec:
      securityContext:
        fsGroup: 1000
      initContainers:
      - name: volume-permissions
        image: busybox:latest
        resources:
          limits:
            cpu: "100m"
            memory: "64Mi"  # Very small, just for chown
          requests:
            cpu: "50m"
            memory: "32Mi"
        command: ["sh", "-c", "chown 1000:1000 /home/node/.n8n && chown -R 1000:1000 /home/node/.n8n"]
        securityContext:
          runAsUser: 0
          privileged: false
        volumeMounts:
        - name: n8n-data
          mountPath: /home/node/.n8n
      containers:
        - name: n8n
          image: n8nio/n8n:latest
          resources:
            limits:
              cpu: "500m"
              memory: "1Gi"   # Your production limit
            requests:
              cpu: "250m"
              memory: "512Mi" # Guaranteed amount
          securityContext:
            runAsUser: 1000
          ports:
            - containerPort: 5678
          env:
            - name: N8N_AUTH_EXCLUDE_ENDPOINTS
              value: "/healthz"
            - name: DB_TYPE
              value: postgresdb
            - name: DB_POSTGRESDB_HOST
              value: postgresql-db.n8n.svc.cluster.local
            - name: DB_POSTGRESDB_PORT
              value: "5432"
            - name: N8N_VERSION_NOTIFICATIONS_ENABLED
              value: "true"
            - name: N8N_SOURCE_CONTROL_ENABLED
              value: "true"
            - name: DB_POSTGRESDB_DATABASE
              value: n8n
            - name: DB_POSTGRESDB_USER
              value: postgres
            - name: N8N_PROXY_HOPS
              value: "1"
            - name: N8N_USER_MANAGEMENT_DISABLED
              value: "false"
            - name: DB_POSTGRESDB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: postgres-password
            - name: N8N_ENCRYPTION_KEY
              valueFrom:
                secretKeyRef:
                  name: n8n-secrets
                  key: N8N_ENCRYPTION_KEY
            - name: N8N_BASIC_AUTH_ACTIVE
              valueFrom:
                secretKeyRef:
                  name: n8n-secrets
                  key: N8N_BASIC_AUTH_ACTIVE
            - name: N8N_BASIC_AUTH_USER
              valueFrom:
                secretKeyRef:
                  name: n8n-secrets
                  key: N8N_BASIC_AUTH_USER
            - name: N8N_BASIC_AUTH_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: n8n-secrets
                  key: N8N_BASIC_AUTH_PASSWORD
            - name: WEBHOOK_URL
              value: https://n8n.sikiru.co.uk
            - name: N8N_HOST
              value: n8n.sikiru.co.uk
            - name: N8N_PORT
              value: "5678"
            - name: N8N_PROTOCOL
              value: https
          volumeMounts:
            - name: n8n-data
              mountPath: /home/node/.n8n
      volumes:
        - name: n8n-data
          persistentVolumeClaim:
            claimName: n8n-data
</file>

<file path="k8s/vault/manual-ingress.yaml">
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: vault-ui
  namespace: vault
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-cloudflare
    # Standard Nginx settings
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
    # Ensure this is owned by the Vault service logic
    app.kubernetes.io/instance: vault
    app.kubernetes.io/name: vault
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - vault.sikiru.co.uk
      secretName: vault-tls
  rules:
    - host: vault.sikiru.co.uk
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: vault-ui  # This match the service created by Helm
                port:
                  number: 8200
</file>

