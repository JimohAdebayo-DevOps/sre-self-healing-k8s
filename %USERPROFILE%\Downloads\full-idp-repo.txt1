<file path="argocd/metallb-app-launcher.yaml">
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: metallb-infrastructure
  namespace: argocd
spec:
  project: default
  source:
    chart: metallb
    repoURL: https://metallb.github.io/metallb
    targetRevision: 0.14.5
  destination:
    server: 'https://kubernetes.default.svc'
    namespace: metallb-system
  syncPolicy:
    automated:
      prune: true 
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true 
      - RespectIgnoreDifferences=true # <--- CRITICAL FIX: Forces SSA to ignore the caBundle
  ignoreDifferences:
    # 1. Ignore the dynamic certificates injected into the CRDs (The true culprit!)
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      jqPathExpressions:
        - '.spec.conversion.webhook.clientConfig.caBundle'
        
    # 2. Ignore the standard Validation webhooks
    - group: admissionregistration.k8s.io
      kind: ValidatingWebhookConfiguration
      jqPathExpressions:
        - '.webhooks[].clientConfig.caBundle'
        
    # 3. Ignore the standard Mutation webhooks
    - group: admissionregistration.k8s.io
      kind: MutatingWebhookConfiguration
      jqPathExpressions:
        - '.webhooks[].clientConfig.caBundle'
</file>

<file path="k8s/metallb/config.yaml">
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: default-pool
  namespace: metallb-system
  annotations:
    argocd.argoproj.io/sync-wave: "5"  # <--- CRITICAL FIX: Waits for Helm to finish
spec:
  addresses:
  - 192.168.0.200-192.168.0.220
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: l2
  namespace: metallb-system
  annotations:
    argocd.argoproj.io/sync-wave: "5"  # <--- CRITICAL FIX: Waits for Helm to finish
spec:
  ipAddressPools:
  - default-pool
</file>

<file path="k8s/vault/secret-store.yaml">
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: vault-backend
spec:
  provider:
    vault:
      # Keeping existing fast internal routing
      server: "http://vault.vault.svc.cluster.local:8200"
      path: "secret"  
      version: "v2"   
      
      # THE CRITICAL SECURITY UPGRADE
      auth:
        kubernetes:
          mountPath: "kubernetes"
          role: "external-secrets-role"
          serviceAccountRef:
            name: "external-secrets"
            namespace: "external-secrets"
</file>

<file path="k8s/n8n/postgres-values.yaml">
auth:
  enabled: true

global:
  postgresql:
    auth:
      existingSecret: postgres-credentials

primary:
  persistence:
    size: 10Gi
    storageClass: longhorn

  resources:
    limits:
      memory: 1Gi
    requests:
      memory: 512Mi

  extraEnvVars:
    # Inject the Keycloak DB password for the creation script
    - name: KEYCLOAK_DB_PASSWORD
      valueFrom:
        secretKeyRef:
          name: keycloak-db-secret
          key: password
    
    # CRITICAL FIX: Inject the Admin password so 'psql' authenticates silently
    - name: PGPASSWORD
      valueFrom:
        secretKeyRef:
          name: postgres-credentials
          key: postgres-password

  initdb:
    scripts:
      01-init-databases.sh: |
        #!/bin/bash
        set -e
        echo "Executing Sovereign Database Initialization..."
        
        # psql will automatically use the $PGPASSWORD environment variable
        psql -v ON_ERROR_STOP=1 --username "postgres" --dbname "postgres" <<-EOSQL
            CREATE DATABASE keycloak;
            CREATE USER keycloak WITH PASSWORD '${KEYCLOAK_DB_PASSWORD}';
            GRANT ALL PRIVILEGES ON DATABASE keycloak TO keycloak;
            
            CREATE DATABASE gridops;
            CREATE DATABASE n8n;
        EOSQL
</file>

<file path="k8s/vault/test-secret.yaml">
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: inventory-secret-sync
  namespace: default  # Where the secret to appear
spec:
  refreshInterval: "1m"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: inventory-k8s-secret  # The name of the resulting K8s secret
    creationPolicy: Owner
  data:
  - secretKey: db_pass_k8s      # The key name in Kubernetes
    remoteRef:
      key: inventory-api        # The name of the secret in Vault UI
      property: database_password # The key inside that Vault secret
</file>

<file path="k8s/cilium/values.yaml">
# sre-self-healing-k8s/k8s/cilium/values.yaml
kubeProxyReplacement: strict
k8sServiceHost: "192.168.0.150" 
k8sServicePort: "6443"

encryption:
  enabled: true
  type: wireguard
  wireguard:
    persistentKeepalive: 25

clusterMesh:
  enabled: true
  apiserver:
    service:
      type: LoadBalancer 

routingMode: native
# ARCHITECTURAL FIX: Define the sovereign network boundary for eBPF native routing
ipv4NativeRoutingCIDR: "172.16.0.0/16"

bpf:
  masquerade: true

ipam:
  mode: "cluster-pool"
  operator:
    clusterPoolIPv4PodCIDRList: ["172.16.0.0/16"]
    clusterPoolIPv4MaskSize: 24
</file>

<file path="k8s/gridops/ingress.yaml">
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gridops-ingress
  namespace: n8n
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-cloudflare
    nginx.ingress.kubernetes.io/backend-protocol: HTTP
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  ingressClassName: nginx
  rules:
    - host: portal.sikiru.co.uk
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gridops-service
                port:
                  number: 80
  tls:
    - hosts:
        - portal.sikiru.co.uk
      secretName: gridops-tls
</file>

