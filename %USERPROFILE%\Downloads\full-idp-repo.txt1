<file path="k8s/gridops/deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gridops-portal
  namespace: n8n # Colocate with DB and n8n for easier networking
  labels:
    app: gridops
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gridops
  template:
    metadata:
      labels:
        app: gridops
    spec:
      serviceAccountName: gridops-portal-sa
      # ==============================================================
      # THE GITOPS SRE UPGRADE: Zero-Touch Migrations & RBAC Bootstrap
      # ==============================================================
      initContainers:
        - name: django-migrate
          image: jimoh1990/gridops:v20
          command: 
            - "/bin/sh"
            - "-c"
            - |
              echo "Executing database migrations..."
              python manage.py migrate
              
              echo "Executing Zero-Touch Superuser Provisioning..."
              # The '|| true' makes this idempotent. If the user already exists 
              # on subsequent pod reboots, it safely ignores the error and continues.
              python manage.py createsuperuser --noinput --username gridadmin --email admin@sikiru.co.uk || true
          env:
            - name: DB_HOST
              value: "postgresql-db.n8n.svc.cluster.local"
            - name: DB_NAME
              value: "gridops"
            - name: DB_USER
              value: "postgres"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: postgres-password
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  key: django-secret-key
            # Django strictly looks for this variable when using --noinput
            - name: DJANGO_SUPERUSER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  # SRE Shortcut: Reusing the Django Secret Key as the initial
                  key: django-secret-key
      containers:
        - name: django
          image: jimoh1990/gridops:v27
          ports:
            - containerPort: 8000
          env:
            # Connect existing HA Postgres
            - name: DB_HOST
              value: "postgresql-db.n8n.svc.cluster.local"
            - name: DB_NAME
              value: "gridops"
            - name: DB_USER
              value: "postgres"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: postgres-password
            - name: GITHUB_TOKEN
              valueFrom:
                secretKeyRef:
                  name: github-token
                  key: GITHUB_TOKEN
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  key: django-secret-key
            - name: OIDC_RP_CLIENT_ID
              value: "gridops-portal"
            - name: OIDC_RP_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  key: oidc-secret
</file>

<file path="k8s/jenkins/values.yaml">
controller:
  image:
    tag: "2.492.1-lts-jdk21"

  # The Absolute Identity Lock
  jenkinsUrl: "https://jenkins.sikiru.co.uk/"

  javaOpts: "-Xms1024m -Xmx1024m -Djava.awt.headless=true"

  securityContext:
    runAsUser: 1000
    fsGroup: 1000

  # Probe Immunity Shield
  probes:
    startupProbe:
      failureThreshold: 60
      periodSeconds: 10

  # CPU & Memory Resources
  resources:
    requests:
      cpu: "500m"
      memory: "1Gi"
    limits:
      cpu: "1000m"
      memory: "2Gi"

  admin:
    existingSecret: "jenkins-admin-credentials"
    userKey: "jenkins-admin-user"
    passwordkey: "jenkins-admin-password"

  # The Modern Plugin Stack (Notice 'oic-auth' is present, 'keycloak' is gone)
  installPlugins:
    - workflow-aggregator
    - git
    - github-branch-source
    - job-dsl
    - kubernetes
    - credentials-binding
    - oic-auth
    - role-strategy
    - configuration-as-code

  # Vault-Backed Secret Injection
  containerEnv:
    - name: GITHUB_USER
      valueFrom:
        secretKeyRef:
          name: jenkins-github-creds
          key: username
    - name: GITHUB_TOKEN
      valueFrom:
        secretKeyRef:
          name: jenkins-github-creds
          key: token
    - name: OIDC_CLIENT_SECRET
      valueFrom:
        secretKeyRef:
          name: jenkins-keycloak-secret
          key: client-secret

  # Jenkins Configuration as Code (JCasC)
  JCasC:
    defaultConfig: true
    configScripts:
      welcome-message: |
        jenkins:
          systemMessage: "Welcome to Sikiru-Lab Jenkins CI/CD. Authenticated via Keycloak OIDC."

      credentials: |
        credentials:
          system:
            domainCredentials:
              - credentials:
                  - usernamePassword:
                      scope: GLOBAL
                      # The ID required by the Job DSL script to scan GitHub
                      id: "github-pat"
                      username: "${GITHUB_USER}"
                      password: "${GITHUB_TOKEN}"
                      description: "GitHub PAT for Organization Scanning and GitOps Write-Back"

      # ==============================================================
      # THE GITOPS SRE UPGRADE: Autonomous GitHub Organization Scanning
      # ==============================================================
      jobs: |
        jobs:
          - script: >
              organizationFolder('GridOps-Platform') {
                  description('Autonomously managed by JCasC and Job DSL')
                  displayName('GridOps Platform Pipelines')
                  organizations {
                      github {
                          repoOwner('JimohAdebayo-DevOps')
                          credentialsId('github-pat')
                          
                          // THE CRITICAL FIX: Explicitly tell Jenkins to discover branches
                          traits {
                              gitHubBranchDiscovery {
                                  strategyId(1) // 1 = Discover all branches
                              }
                              gitHubPullRequestDiscovery {
                                  strategyId(1) // Discover PRs merging with the target branch
                              }
                          }
                      }
                  }
                  projectFactories {
                      workflowMultiBranchProjectFactory {
                          scriptPath('Jenkinsfile')
                      }
                  }
                  triggers {
                      periodicFolderTrigger {
                          interval('1d')
                      }
                  }
              }

      # The Modern OIDC Security Realm
      security: |
        jenkins:
          securityRealm:
            oic:
              clientId: "jenkins"
              clientSecret: "${OIDC_CLIENT_SECRET}"
              # ==============================================================
              # THE CRITICAL FIX: Deterministic Manual Configuration
              # Matches Django portal to bypass aggressive scope discovery
              # ==============================================================
              serverConfiguration:
                manual:
                  issuer: "https://sso.sikiru.co.uk/realms/Sikiru-Lab"
                  authorizationServerUrl: "https://sso.sikiru.co.uk/realms/Sikiru-Lab/protocol/openid-connect/auth"
                  tokenServerUrl: "https://sso.sikiru.co.uk/realms/Sikiru-Lab/protocol/openid-connect/token"
                  userInfoServerUrl: "https://sso.sikiru.co.uk/realms/Sikiru-Lab/protocol/openid-connect/userinfo"
                  jwksServerUrl: "https://sso.sikiru.co.uk/realms/Sikiru-Lab/protocol/openid-connect/certs"
                  scopes: "openid profile email"
              userNameField: "preferred_username"
              groupsFieldName: "groups"
          authorizationStrategy:
            roleBased:
              roles:
                global:
                  - name: "admin"
                    description: "GridOps Platform Administrators"
                    permissions:
                      - "Overall/Administer"
                    entries:
                      - group: "jenkins-admins"
                  - name: "developer"
                    description: "GridOps Developers"
                    permissions:
                      - "Overall/Read"
                      - "Job/Build"
                      - "Job/Read"
                      - "Job/Workspace"
                    entries:
                      - group: "GridEngineers"

  # Networking (Ingress)
  ingress:
    enabled: true
    ingressClassName: nginx
    hostName: jenkins.sikiru.co.uk
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-cloudflare
      nginx.ingress.kubernetes.io/proxy-body-size: "50m"
      nginx.ingress.kubernetes.io/backend-protocol: HTTP
      # Strict 301 Loop Prevention
      nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
      # JWT Buffer Expansion
      nginx.ingress.kubernetes.io/proxy-buffer-size: "128k"
      nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
      nginx.ingress.kubernetes.io/proxy-busy-buffers-size: "256k"
      nginx.ingress.kubernetes.io/large-client-header-buffers: "4 128k"
    tls:
      - secretName: jenkins-tls-cert
        hosts:
          - jenkins.sikiru.co.uk

  # Service Account for CI/CD Pipelines
  serviceAccount:
    create: true
    name: jenkins
</file>

</files>
