<file path="argocd/vault-launcher.yaml">
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: vault
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  project: default
  sources:
    - repoURL: https://helm.releases.hashicorp.com
      chart: vault
      targetRevision: 0.27.0
      helm:
        valueFiles:
          - $values/k8s/vault/values.yaml
    - repoURL: 'https://github.com/JimohAdebayo-DevOps/sre-self-healing-k8s.git'
      targetRevision: main
      ref: values
      path: k8s/vault  # <-- It tells Argo to apply "manual-ingress.yaml"
  destination:
    server: https://kubernetes.default.svc
    namespace: vault
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
  ignoreDifferences:
    - group: admissionregistration.k8s.io
      kind: MutatingWebhookConfiguration
      name: vault-agent-injector-cfg
      jqPathExpressions:
        - .webhooks[].clientConfig.caBundle
      jsonPointers:
        - /webhooks/0/clientConfig/caBundle
</file>

<file path="k8s/logging/values.yaml">
loki:
  image:
    repository: grafana/loki
    tag: 2.9.3 
    pullPolicy: IfNotPresent
  enabled: true
  auth_enabled: false
  isDefault: false
  persistence:
    enabled: true
    storageClassName: longhorn # Uses RAID-backed storage
    size: 10Gi
    accessModes:
      - ReadWriteOnce

  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 100m
      memory: 256Mi

promtail:
  enabled: true
  # Promtail needs to run on every node to catch all logs
  config:
    lokiAddress: http://logging-stack-loki.logging.svc.cluster.local:3100/loki/api/v1/push
    clients:
      - url: http://logging-stack-loki.logging.svc.cluster.local:3100/loki/api/v1/push

# Disable things already have or don't need
grafana:
  enabled: false
prometheus:
  enabled: false
fluent-bit:
  enabled: false
</file>

<file path="k8s/vault/external-secrets.yaml">
# ==========================================
# 1. CENTRAL DATA PLANE (n8n Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: postgres-credentials-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: postgres-credentials
  data:
    - secretKey: postgres-password
      remoteRef:
        key: postgres-credentials
        property: postgres-password
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: keycloak-db-secret-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: keycloak-db-secret
  data:
    - secretKey: password
      remoteRef:
        key: keycloak-db-secret
        property: password
---
# ==========================================
# 2. GRIDOPS PORTAL (n8n Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: gridops-secrets-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: gridops-secrets
  data:
    - secretKey: django-secret-key
      remoteRef:
        key: gridops-secrets
        property: django-secret-key
    - secretKey: oidc-secret
      remoteRef:
        key: gridops-secrets
        property: oidc-secret
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: github-token-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: github-token
  data:
    - secretKey: GITHUB_TOKEN
      remoteRef:
        key: github-token
        property: GITHUB_TOKEN
---
# ==========================================
# 3. N8N AUTOMATION (n8n Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: n8n-secrets-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: n8n-secrets
  data:
    - secretKey: N8N_ENCRYPTION_KEY
      remoteRef:
        key: n8n-secrets
        property: N8N_ENCRYPTION_KEY
    - secretKey: N8N_BASIC_AUTH_ACTIVE
      remoteRef:
        key: n8n-secrets
        property: N8N_BASIC_AUTH_ACTIVE
    - secretKey: N8N_BASIC_AUTH_USER
      remoteRef:
        key: n8n-secrets
        property: N8N_BASIC_AUTH_USER
    - secretKey: N8N_BASIC_AUTH_PASSWORD
      remoteRef:
        key: n8n-secrets
        property: N8N_BASIC_AUTH_PASSWORD
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: cloudflare-tunnel-token-es
  namespace: n8n
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: cloudflare-tunnel-token
  data:
    - secretKey: token
      remoteRef:
        key: cloudflare-tunnel-token
        property: token
---
# ==========================================
# 4. GITOPS CONTROL PLANE (argocd Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: sre-repo-creds-es
  namespace: argocd
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: sre-repo-creds
  data:
    - secretKey: url
      remoteRef:
        key: sre-repo-creds
        property: url
    - secretKey: password
      remoteRef:
        key: sre-repo-creds
        property: password
    - secretKey: username
      remoteRef:
        key: sre-repo-creds
        property: username
    - secretKey: type
      remoteRef:
        key: sre-repo-creds
        property: type
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: argocd-initial-admin-es
  namespace: argocd
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: argocd-initial-admin-secret
  data:
    - secretKey: password
      remoteRef:
        key: argocd-initial-admin-secret
        property: password
---
# ==========================================
# 5. SOVEREIGN IDENTITY (keycloak Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: keycloak-admin-secret-es
  namespace: keycloak
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: keycloak-admin-secret
  data:
    - secretKey: admin-password
      remoteRef:
        key: keycloak-admin-secret
        property: admin-password
---
# IMPORTANT: Keycloak also needs the DB password in its own namespace
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: keycloak-db-secret-es
  namespace: keycloak
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: keycloak-db-secret
  data:
    - secretKey: password
      remoteRef:
        key: keycloak-db-secret
        property: password
---
# ==========================================
# 6. ZERO TRUST GATEKEEPER (oauth2-proxy Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: oauth2-proxy-creds-es
  namespace: oauth2-proxy
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: oauth2-proxy-creds
  data:
    - secretKey: client-id
      remoteRef:
        key: oauth2-proxy-creds
        property: client-id
    - secretKey: client-secret
      remoteRef:
        key: oauth2-proxy-creds
        property: client-secret
    - secretKey: cookie-secret
      remoteRef:
        key: oauth2-proxy-creds
        property: cookie-secret
---
# ==========================================
# 7. CI/CD ENGINES (jenkins Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: jenkins-admin-credentials-es
  namespace: jenkins
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: jenkins-admin-credentials
  data:
    - secretKey: jenkins-admin-user
      remoteRef:
        key: jenkins-admin-credentials
        property: jenkins-admin-user
    - secretKey: jenkins-admin-password
      remoteRef:
        key: jenkins-admin-credentials
        property: jenkins-admin-password
---
# ==========================================
# 8. OBSERVABILITY (monitoring Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: grafana-admin-credentials-es
  namespace: monitoring
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: grafana-admin-credentials
  data:
    - secretKey: admin-user
      remoteRef:
        key: grafana-admin-credentials
        property: admin-user
    - secretKey: admin-password
      remoteRef:
        key: grafana-admin-credentials
        property: admin-password
---
# ==========================================
# CI/CD: DOCKER HUB FOR KANIKO (jenkins Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: dockerhub-creds-kaniko-es
  namespace: jenkins
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: dockerhub-creds-kaniko
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        # Dynamically builds the Docker config JSON using Vault data
        .dockerconfigjson: '{"auths": {"https://index.docker.io/v1/": {"auth": "{{ printf "%s:%s" .username .password | b64enc }}"}}}'
  data:
    - secretKey: username
      remoteRef:
        key: dockerhub-creds
        property: username
    - secretKey: password
      remoteRef:
        key: dockerhub-creds
        property: password
---
# ==========================================
# CI/CD: GITHUB GITOPS TOKEN (jenkins Namespace)
# ==========================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: jenkins-github-creds-es
  namespace: jenkins
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: jenkins-github-creds
  data:
    - secretKey: username
      remoteRef:
        key: jenkins-github-creds
        property: username
    - secretKey: token
      remoteRef:
        key: jenkins-github-creds
        property: token
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: jenkins-keycloak-vault-sync
  namespace: jenkins
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: jenkins-keycloak-secret
    creationPolicy: Owner
  data:
    - secretKey: client-secret
      remoteRef:
        key: jenkins-keycloak-secret
        property: client-secret
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: argocd-github-vault-sync
  namespace: argocd
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    # This is the K8s secret ESO will create
    name: argocd-github-org-creds
    creationPolicy: Owner
    template:
      metadata:
        labels:
          # THE CRITICAL BINDING: This label tells Argo CD to use this as an Organization Credential
          argocd.argoproj.io/secret-type: repo-creds
      data:
        # Argo CD strictly requires these keys for a repository credential template
        url: "https://github.com/JimohAdebayo-DevOps"
        type: "git"
        username: "{{ .github_user }}"
        password: "{{ .github_token }}"
  data:
    - secretKey: github_user
      remoteRef:
        key: jenkins-github-creds
        property: username
    - secretKey: github_token
      remoteRef:
        key: jenkins-github-creds
        property: token
</file>

<file path="k8s/vault/values.yaml">
server:
  # 1. DISABLE DEV MODE
  dev:
    enabled: false
  
  # 2. ENABLE PERSISTENCE (Write to disk)
  dataStorage:
    enabled: true
    size: 10Gi
    storageClass: "longhorn"
    accessMode: ReadWriteOnce

  # 3. RESOURCE LIMITS (Production Sizing)
  resources:
    requests:
      memory: 512Mi
      cpu: 250m
    limits:
      memory: 1Gi
      cpu: 500m

  # 4. STANDALONE MODE (Simpler than HA for a single-cluster IDP)
  # To use a file backend which is robust enough for this scale
  ha:
    enabled: false

# 5. UI Configuration
ui:
  enabled: true
  serviceType: "ClusterIP"
  serviceNodePort: null
  externalPort: 8200

  # To keep this disabled because of using 'manual-ingress.yaml'
  ingress:
    enabled: false
</file>

