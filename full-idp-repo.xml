            clientSecret: $dex.github.clientSecret
            orgs:
              - name: JimohAdebayo-DevOps

server:
  insecure: true
  extraArgs:
    - --insecure

  service:
    type: ClusterIP
    servicePortHttp: 80

  ingress:
