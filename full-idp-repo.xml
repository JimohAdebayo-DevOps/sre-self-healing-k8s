<file path="k8s/keycloak/values.yaml">
auth:
  adminUser: admin
  existingSecret: keycloak-admin-secret
  passwordKey: admin-password

# Fixed for Bitnami image deprecation
image:
  registry: docker.io
  repository: bitnamilegacy/keycloak
  tag: 26.3.3-debian-12-r0

# Disabled internal DB and point to n8n Postgres
postgresql:
  enabled: false

externalDatabase:
  host: postgresql-db.n8n.svc.cluster.local
  port: 5432
  user: keycloak
  database: keycloak
  existingSecret: keycloak-db-secret
  existingSecretPasswordKey: password

# Keycloak 26 Proxy & Hostname Configuration
proxy: edge
extraEnvVars:
  - name: KC_PROXY
    value: "edge" 
  - name: KC_PROXY_HEADERS
    value: "xforwarded"
  - name: KC_HOSTNAME_URL
    value: "https://sso.sikiru.co.uk" 
  - name: KC_HTTP_RELATIVE_PATH
    value: "/"

# Optimized resources
resources:
  limits:
    memory: 2Gi
    cpu: 1000m
  requests:
    memory: 1Gi
    cpu: 500m

# Corrected Ingress Section
ingress:
  enabled: true
  ingressClassName: nginx
  hostname: sso.sikiru.co.uk
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-cloudflare
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
    nginx.ingress.kubernetes.io/proxy-buffer-size: "128k"
    nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
    nginx.ingress.kubernetes.io/proxy-busy-buffers-size: "256k"
  # FIXED: Bitnami expects a boolean 'true' here, not a list
  tls: true
</file>

<file path="k8s/gridops/deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gridops-portal
  namespace: n8n # Colocate with DB and n8n for easier networking
  labels:
    app: gridops
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gridops
  template:
    metadata:
      labels:
        app: gridops
    spec:
      containers:
        - name: django
          image: jimoh1990/gridops:v20
          ports:
            - containerPort: 8000
          env:
            # Connect existing HA Postgres
            - name: DB_HOST
              value: "postgresql-db.n8n.svc.cluster.local"
            - name: DB_NAME
              value: "gridops"
            - name: DB_USER
              value: "postgres"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: postgres-password
            - name: GITHUB_TOKEN
              valueFrom:
                secretKeyRef:
                  name: github-token
                  key: GITHUB_TOKEN
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  key: django-secret-key
            - name: OIDC_RP_CLIENT_ID
              value: "gridops-portal"
            - name: OIDC_RP_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: gridops-secrets
                  key: oidc-secret
</file>

